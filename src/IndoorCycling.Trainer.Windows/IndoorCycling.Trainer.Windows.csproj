<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinRT>true</UseWinRT>
    <AntPlusNetworkKeyPath Condition="'$(AntPlusNetworkKeyPath)' == '' and '$(WODRA_ANTPLUS_NETWORK_KEY_PATH)' != ''">$(WODRA_ANTPLUS_NETWORK_KEY_PATH)</AntPlusNetworkKeyPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(AntPlusNetworkKeyPath)' != '' and Exists('$(AntPlusNetworkKeyPath)')">
    <EmbeddedResource Include="$(AntPlusNetworkKeyPath)" LogicalName="Wodra.AntPlusNetworkKey" />
  </ItemGroup>

  <Target Name="ValidateRequiredAntPlusNetworkKey" BeforeTargets="PrepareForBuild"
          Condition="'$(RequireAntPlusNetworkKey)' == 'true'">
    <Error Condition="'$(AntPlusNetworkKeyPath)' == ''"
           Text="ANT+ release build requires AntPlusNetworkKeyPath or WODRA_ANTPLUS_NETWORK_KEY_PATH outside the repository." />
    <Error Condition="'$(AntPlusNetworkKeyPath)' != '' and !Exists('$(AntPlusNetworkKeyPath)')"
           Text="Configured ANT+ network-key material was not found. Supply the private ANT+ build configuration file." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\IndoorCycling.Core\IndoorCycling.Core.csproj" />
    <ProjectReference Include="..\IndoorCycling.Trainer\IndoorCycling.Trainer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ANT_NET">
      <HintPath>AntSdk\ANT_NET.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Update="AntSdk\ANT_WrappedLib.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="AntSdk\ANT-SDK-License.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
