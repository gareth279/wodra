<Project Sdk="Godot.NET.Sdk/4.6.2">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <AssemblyName>IndoorCycling.Game</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\Routes\dunedin-one-way-oval-gardens.route-points.json" LogicalName="Wodra.GameData.Routes.dunedin-one-way-oval-gardens.route-points.json" />
    <EmbeddedResource Include="Data\Routes\dunedin-one-way-oval-gardens.landmarks.json" LogicalName="Wodra.GameData.Routes.dunedin-one-way-oval-gardens.landmarks.json" />
    <EmbeddedResource Include="Data\Routes\dunedin-one-way-oval-gardens.buildings.json" LogicalName="Wodra.GameData.Routes.dunedin-one-way-oval-gardens.buildings.json" />
    <EmbeddedResource Include="Data\Routes\dunedin-one-way-oval-gardens.vegetation.json" LogicalName="Wodra.GameData.Routes.dunedin-one-way-oval-gardens.vegetation.json" />
    <EmbeddedResource Include="Data\Routes\dunedin-one-way-oval-gardens.street-furniture.json" LogicalName="Wodra.GameData.Routes.dunedin-one-way-oval-gardens.street-furniture.json" />
    <EmbeddedResource Include="Data\Routes\dunedin-one-way-oval-gardens.terrain.json" LogicalName="Wodra.GameData.Routes.dunedin-one-way-oval-gardens.terrain.json" />
    <EmbeddedResource Include="Data\Routes\dunedin-one-way-oval-gardens.streets.json" LogicalName="Wodra.GameData.Routes.dunedin-one-way-oval-gardens.streets.json" Condition="Exists('Data\Routes\dunedin-one-way-oval-gardens.streets.json')" />
    <ProjectReference Include="..\IndoorCycling.Core\IndoorCycling.Core.csproj" />
    <ProjectReference Include="..\IndoorCycling.Trainer\IndoorCycling.Trainer.csproj" />    
    <ProjectReference Include="..\IndoorCycling.Trainer.Windows\IndoorCycling.Trainer.Windows.csproj" />
</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IndoorCycling.Persistence.Sqlite\IndoorCycling.Persistence.Sqlite.csproj" />
  </ItemGroup>
</Project>
