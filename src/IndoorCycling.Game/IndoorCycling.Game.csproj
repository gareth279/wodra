<Project Sdk="Godot.NET.Sdk/4.6.2">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <AssemblyName>IndoorCycling.Game</AssemblyName>
    <RestoreBuildInParallel>false</RestoreBuildInParallel>
    <BuildInParallel>false</BuildInParallel>
    <EosSdkRoot Condition="'$(EosSdkRoot)' == '' and '$(EOS_SDK_ROOT)' != ''">$(EOS_SDK_ROOT)</EosSdkRoot>
    <EosSdkRoot Condition="'$(EosSdkRoot)' == ''">$(LOCALAPPDATA)\Wodra\EOS-SDK</EosSdkRoot>
    <EnableEpicOnlineServices Condition="'$(EnableEpicOnlineServices)' == '' and Exists('$(EosSdkRoot)\SDK\Source\Generated\Bindings.cs') and Exists('$(EosSdkRoot)\SDK\Bin\EOSSDK-Win64-Shipping.dll')">true</EnableEpicOnlineServices>
    <EnableEpicOnlineServices Condition="'$(EnableEpicOnlineServices)' == ''">false</EnableEpicOnlineServices>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <EmbeddedResource Include="Data\Routes\dunedin-one-way-oval-gardens.route-points.json" LogicalName="Wodra.GameData.Routes.dunedin-one-way-oval-gardens.route-points.json" />
    <EmbeddedResource Include="Data\Routes\dunedin-one-way-oval-gardens.landmarks.json" LogicalName="Wodra.GameData.Routes.dunedin-one-way-oval-gardens.landmarks.json" />
    <EmbeddedResource Include="Data\Routes\dunedin-one-way-oval-gardens.buildings.json" LogicalName="Wodra.GameData.Routes.dunedin-one-way-oval-gardens.buildings.json" />
    <EmbeddedResource Include="Data\Routes\dunedin-one-way-oval-gardens.vegetation.json" LogicalName="Wodra.GameData.Routes.dunedin-one-way-oval-gardens.vegetation.json" />
    <EmbeddedResource Include="Data\Routes\dunedin-one-way-oval-gardens.street-furniture.json" LogicalName="Wodra.GameData.Routes.dunedin-one-way-oval-gardens.street-furniture.json" />
    <EmbeddedResource Include="Data\Routes\dunedin-one-way-oval-gardens.terrain.json" LogicalName="Wodra.GameData.Routes.dunedin-one-way-oval-gardens.terrain.json" />
    <EmbeddedResource Include="Data\Routes\dunedin-one-way-oval-gardens.streets.json" LogicalName="Wodra.GameData.Routes.dunedin-one-way-oval-gardens.streets.json" Condition="Exists('Data\Routes\dunedin-one-way-oval-gardens.streets.json')" />
    <ProjectReference Include="..\IndoorCycling.Core\IndoorCycling.Core.csproj" />
    <ProjectReference Include="..\IndoorCycling.Trainer\IndoorCycling.Trainer.csproj" />    
    <ProjectReference Include="..\IndoorCycling.Trainer.Windows\IndoorCycling.Trainer.Windows.csproj" />
    <ProjectReference Include="..\Wodra.Multiplayer.Protocol\Wodra.Multiplayer.Protocol.csproj" />
</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IndoorCycling.Persistence.Sqlite\IndoorCycling.Persistence.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableEpicOnlineServices)' == 'true'">
    <Compile Include="$(EosSdkRoot)\SDK\Source\Core\**\*.cs" Link="EOS-SDK\Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(EosSdkRoot)\SDK\Source\Generated\**\*.cs" Exclude="$(EosSdkRoot)\SDK\Source\Generated\Android\**\*.cs" Link="EOS-SDK\Generated\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="$(EosSdkRoot)\SDK\Bin\EOSSDK-Win64-Shipping.dll" Link="EOSSDK-Win64-Shipping.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup Condition="'$(EnableEpicOnlineServices)' == 'true'">
    <DefineConstants>$(DefineConstants);EOS_PLATFORM_WINDOWS_64;WODRA_EOS_SDK</DefineConstants>
  </PropertyGroup>

  <Target Name="RequireEpicOnlineServicesSdk" BeforeTargets="CoreCompile" Condition="'$(EnableEpicOnlineServices)' == 'true' and !Exists('$(EosSdkRoot)\SDK\Source\Generated\Bindings.cs')">
    <Error Text="EOS SDK was requested but not found. Set EOS_SDK_ROOT or EosSdkRoot to the extracted EOS C# SDK root." />
  </Target>
</Project>
