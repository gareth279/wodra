<Project Sdk="Godot.NET.Sdk/4.6.2">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <AssemblyName>IndoorCycling.Game</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\Routes\dunedin-one-way-oval-gardens.route-points.json"
                      LogicalName="GWift.GameData.Routes.dunedin-one-way-oval-gardens.route-points.json" />
    <EmbeddedResource Include="Data\Routes\dunedin-one-way-oval-gardens.landmarks.json"
                      LogicalName="GWift.GameData.Routes.dunedin-one-way-oval-gardens.landmarks.json" />
    <EmbeddedResource Include="Data\Routes\dunedin-one-way-oval-gardens.buildings.json"
                      LogicalName="GWift.GameData.Routes.dunedin-one-way-oval-gardens.buildings.json" />
    <EmbeddedResource Include="Data\Routes\dunedin-one-way-oval-gardens.vegetation.json"
                      LogicalName="GWift.GameData.Routes.dunedin-one-way-oval-gardens.vegetation.json" />
    <EmbeddedResource Include="Data\Routes\dunedin-one-way-oval-gardens.street-furniture.json"
                      LogicalName="GWift.GameData.Routes.dunedin-one-way-oval-gardens.street-furniture.json" />
    <ProjectReference Include="..\IndoorCycling.Core\IndoorCycling.Core.csproj" />
    <ProjectReference Include="..\IndoorCycling.Trainer\IndoorCycling.Trainer.csproj" />    
    <ProjectReference Include="..\IndoorCycling.Trainer.Windows\IndoorCycling.Trainer.Windows.csproj" />
</ItemGroup>
</Project>
